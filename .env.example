# Copy to .env and generate independent random secrets before deployment.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=alamut.bar,driver.alamut.bar,owner.alamut.bar,inspector.alamut.bar,admin.alamut.bar,127.0.0.1,backend
DB_ENGINE=mysql
MYSQL_DATABASE=alamut
MYSQL_USER=alamut
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
CSRF_TRUSTED_ORIGINS=https://alamut.bar,https://driver.alamut.bar,https://owner.alamut.bar,https://inspector.alamut.bar,https://admin.alamut.bar
DEMO_ENABLED=0
SECURE_SSL_REDIRECT=1
# Set to redis://redis:6379/1 in a multi-worker deployment.
REDIS_URL=
# Preserve independently when rotating DJANGO_SECRET_KEY.
SECURITY_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
MULTI_APP=1
SITE_URL=https://alamut.bar
DRIVER_URL=https://driver.alamut.bar
OWNER_URL=https://owner.alamut.bar
INSPECTOR_URL=https://inspector.alamut.bar
ADMIN_URL=https://admin.alamut.bar
# Legacy single-app migration only. Leave empty for the multi-app deployment.
APP_URL=
GOOGLE_SITE_VERIFICATION=
# Public values displayed on the contact, privacy and terms pages.
BUSINESS_OPERATOR_NAME=
BUSINESS_CONTACT_EMAIL=
BUSINESS_RETENTION_NOTICE=
BUSINESS_TERMS_NOTICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=no-reply@your-domain.example
