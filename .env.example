PORT=5088
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alamut
DB_USER=root
DB_PASS=
# روی ویندوز/زمپ همیشه 127.0.0.1 بگذارید، نه localhost.
# DB_SYNC_ALTER=true را روشن نکنید؛ ALTER روی هر npm run dev ایندکس تکراری می‌سازد و به Too many keys می‌رسد.
JWT_SECRET=alamut-dev-secret-change-me
# Only applied when an operator row is first created. Dev default is Alamut@1234.
ADMIN_SEED_PASSWORD=
