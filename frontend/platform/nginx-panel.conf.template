server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $alamut_backend backend:8000;
    client_max_body_size 12m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    add_header Cache-Control "no-store" always;
    location /api/ {
        proxy_pass http://$alamut_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_read_timeout 90s;
    }
    location = /pwa/worker {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        add_header Service-Worker-Allowed "/";
        add_header X-Robots-Tag "noindex, nofollow";
        try_files $uri =404;
    }
    location ~ ^/(assets|fonts|pwa/icons)/ { try_files $uri =404; }
    location = /robots.txt { try_files $uri =404; }
    location = /pwa/${ALAMUT_PANEL}/manifest.webmanifest { default_type application/manifest+json; try_files $uri =404; }
    location = / { try_files /index.html =404; }
    location ~ ^/(${ALAMUT_PANEL}(/.*)?|login|recover|register)/?$ { try_files $uri /index.html; }
    location / { try_files $uri =404; }
}
